# Bu dosyayi .env olarak kopyalayip doldurun. .env COMMIT EDILMEZ.

# ZORUNLU - API-Football / API-Sports anahtari
API_FOOTBALL_KEY=

# ONERILEN - kalici snapshot gecmisi icin PostgreSQL (Neon, Supabase, Render)
# Verilmezse SQLite kullanilir ve uygulama "gecici" uyarisi gosterir.
DATABASE_URL=

# CORS - GitHub Pages adresiniz. Birden fazlaysa virgulle ayirin.
ALLOWED_ORIGINS=http://localhost:8000,https://KULLANICI.github.io

# Istege bagli
LEAGUE_IDS=39,140,135,78,61,203
TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
SNAPSHOT_ENABLED=true
SNAPSHOT_INTERVAL_MINUTES=180
MAX_CALLS_PER_REFRESH=400
